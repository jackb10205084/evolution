{
  "name": "homeplay-play-ground",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3002",
    "preview:check": "node scripts/check-preview.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run assets:validate && npm run floorplans:validate && npm run pilot:audit && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "assets:build": "node scripts/build-hero-assets.mjs && npm run assets:optimize",
    "assets:optimize": "node scripts/optimize-hero-assets.mjs",
    "assets:validate": "node scripts/validate-hero-assets.mjs",
    "blender:pilot:spec": "node --import tsx scripts/blender/export-a6-painterly-spec.ts",
    "blender:pilot:build": "node scripts/blender/run-painterly-pilot.mjs",
    "blender:pilot:validate": "node scripts/blender/validate-painterly-pilot.mjs",
    "blender:watercolor:v2": "node scripts/blender/run-watercolor-pipeline-v2.mjs",
    "blender:watercolor:v2:reuse": "node scripts/blender/run-watercolor-pipeline-v2.mjs --reuse-base",
    "blender:watercolor:v2:validate": "node scripts/blender/validate-watercolor-pipeline-v2.mjs",
    "blender:watercolor:v2:composites:validate": "node scripts/blender/validate-watercolor-composites-v2.mjs",
    "floorplans:validate": "node scripts/validate-floorplan-runtime.mjs",
    "pilot:audit": "node scripts/audit-commercial-pilot.mjs",
    "pilot:release": "node scripts/audit-commercial-pilot.mjs --release",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@gltf-transform/cli": "^4.4.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "gltf-validator": "^2.0.0-dev.3.10",
    "miniflare": "^4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
